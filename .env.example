# Copy to .env (gitignored). scripts/run_api.sh sources it on start.

# Postgres (the Docker Compose default; change the password if you expose the port)
DATABASE_URL=postgresql://raymap:raymap@127.0.0.1:5433/raymap

# Required to reach /internal/* from anywhere other than localhost, and REQUIRED
# on a public deployment: behind nginx every request looks like it came from
# loopback, so the loopback exemption is refused and only this token works.
# Generate with: openssl rand -hex 24
RAYMAP_ADMIN_TOKEN=

# Default resolution when a request omits ?res (3-6; 6 is the finest shown)
RAYMAP_HEX_RES=6

# Maintenance loop cadence in seconds (0 disables it)
RAYMAP_MAINTAIN_INTERVAL_S=300

# Retention
RAYMAP_RAW_RETAIN_HOURS=72
RAYMAP_CELL_RETAIN_DAYS=90

# Ingest quota per device per hour
RAYMAP_QUOTA_RECORDS_HOUR=600

# Device reader cadence (org.raymap.device) and where it posts
RAYMAP_UPLOAD_INTERVAL_S=900
RAYMAP_INGEST=http://127.0.0.1:8000/ingest

# Backups (scripts/backup_db.sh)
RAYMAP_BACKUP_DIR=/Users/admin/raymap-backups
RAYMAP_BACKUP_KEEP=14
