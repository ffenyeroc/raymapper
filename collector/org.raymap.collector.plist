<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Install with:
    cp org.raymap.collector.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/org.raymap.collector.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.raymap.collector</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/admin/raymap-map/collector/.venv/bin/python</string>
    <string>/Users/admin/raymap-map/collector/collector.py</string>
    <string>--config</string>
    <string>/Users/admin/raymap-map/collector/config.toml</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/admin/raymap-map/collector</string>

  <key>KeepAlive</key>
  <true/>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/admin/Library/Logs/raymap-collector.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/admin/Library/Logs/raymap-collector.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>